{
  "name": "slurm-view-ood",
  "version": "1.0.0",
  "description": "testing",
  "main": "app.js",
  "scripts": {
    "test": "jest --coverage",
    "pretest": "npm run server:build",
    "start": "node app.js",
    "dev:server": "tsx watch --tsconfig tsconfig.server.json src/server/index.ts",
    "dev": "concurrently -k -n server,client \"npm run dev:server\" \"npm run client:dev\"",
    "client:dev": "vite",
    "client:build": "vite build",
    "client:typecheck": "node node_modules/@typescript/native/bin/tsc -b",
    "server:build": "node node_modules/@typescript/native/bin/tsc -p tsconfig.server.json",
    "server:typecheck": "node node_modules/@typescript/native/bin/tsc -p tsconfig.server.json --noEmit",
    "build": "npm run server:build && npm run client:build",
    "typecheck": "npm run server:typecheck && npm run client:typecheck"
  },
  "author": "Anish Chanda",
  "license": "ISC",
  "dependencies": {
    "@isaacs/ttlcache": "^2.1.5",
    "@tailwindcss/vite": "^4.3.3",
    "@tanstack/react-query": "^5.102.8",
    "@tanstack/react-table": "^9.2.4",
    "d3": "^7.9.0",
    "express": "^4.22.2",
    "express-handlebars": "^8.0.1",
    "node-cache": "^5.1.2",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "tailwindcss": "^4.3.3",
    "yaml": "^2.9.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@babel/core": "^7.29.7",
    "@babel/preset-env": "^7.29.7",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.7",
    "@types/d3": "^7.4.3",
    "@types/express": "^4.17.25",
    "@types/jest": "^29.5.14",
    "@types/node": "^26.4.1",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.7",
    "@types/supertest": "^7.2.1",
    "@typescript/native": "npm:typescript@^7.0.2",
    "@vitejs/plugin-react": "^6.1.1",
    "babel-jest": "^29.7.0",
    "concurrently": "^10.0.5",
    "jest": "^29.7.0",
    "jest-environment-jsdom": "^29.7.0",
    "jsdom": "^27.4.0",
    "supertest": "^7.2.2",
    "ts-jest": "^29.4.12",
    "tsx": "^4.23.13",
    "typescript": "npm:@typescript/typescript6@^6.0.2",
    "vite": "^8.2.2"
  }
}
